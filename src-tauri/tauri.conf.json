{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quaver",
  "version": "0.1.0",
  "identifier": "com.quaver.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quaver",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "transparent": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Music",
    "shortDescription": "A native macOS FLAC / ALAC music player with synced lyrics.",
    "longDescription": "Quaver is a lightweight, premium macOS music player for high-quality local audio files (FLAC, ALAC, MP3) with Apple Music-style synced lyrics and a vinyl-inspired now-playing view.",
    "copyright": "Copyright © 2026",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {}
}
